{
  "name": "rainbow-html",
  "displayName": "Rainbow HTML",
  "description": "Vibrant alternating rainbow colors for HTML tag delimiters and names to enhance complex nested HTML readability.",
  "version": "0.0.9",
  "license": "MIT",
  "author": {
    "name": "Alfredo Lavin",
    "email": "alfredolavin@gmail.com",
    "url": "https://github.com/alfredolavin"
  },
  "publisher": "alfredolavin",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredolavin/rainbowHTML"
  },
  "bugs": {
    "url": "https://github.com/alfredolavin/rainbowHTML/issues"
  },
  "homepage": "https://github.com/alfredolavin/rainbowHTML#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Themes",
    "Other"
  ],
  "keywords": [
    "html",
    "rainbow",
    "color",
    "highlighting",
    "jsx",
    "tsx",
    "vue",
    "svelte",
    "astro",
    "tags",
    "delimiters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:jsx",
    "onLanguage:tsx",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:php",
    "onLanguage:blade",
    "onLanguage:handlebars",
    "onLanguage:razor",
    "onLanguage:xml",
    "onLanguage:svg",
    "onLanguage:nunjucks",
    "onLanguage:twig",
    "onLanguage:jinja-html",
    "onLanguage:django-html"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rainbow HTML",
      "properties": {
        "rainbow-html.colorMode": {
          "type": "string",
          "enum": [
            "rainbow",
            "depth",
            "tagNameHash",
            "uniqueTagNames"
          ],
          "enumDescriptions": [
            "Alternating rainbow colors cycling through nested and consecutive tags (recommended).",
            "Rainbow colors based on tag nesting depth level.",
            "Tag color calculated by hashing tag name into the rainbow palette.",
            "Assign unique rainbow colors to each distinct tag type in the document."
          ],
          "default": "rainbow",
          "description": "Coloring strategy for HTML tags."
        },
        "rainbow-html.additionalFileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "njk",
            "nunjucks",
            "php",
            "vue",
            "svelte",
            "astro",
            "blade",
            "twig"
          ],
          "description": "Additional file extensions (e.g. 'njk', 'blade') or language IDs (e.g. 'nunjucks') to scan for HTML tags."
        },
        "rainbow-html.tagColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Manual color overrides for specific tag names (e.g., {\"div\": \"#ff5555\", \"span\": \"#50fa7b\"}). Tag names are case-insensitive."
        },
        "rainbow-html.tagShadow": {
          "type": "string",
          "default": "1px 1px 2px rgba(0, 0, 0, 0.4)",
          "description": "Configurable CSS text-shadow applied to HTML tag names in the editor (e.g. '1px 1px 2px rgba(0, 0, 0, 0.4)', '0px 1px 3px #000000', or 'none' to disable)."
        }
      }
    },
    "commands": [
      {
        "command": "rainbow-html.refresh",
        "title": "Rainbow HTML: Refresh Highlighting"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.3.3"
  }
}